scalar UUID
scalar Date
scalar DateTime

# Base interface for all media types
interface Media {
  id: UUID!
  title: String!
  releaseDate: Date
  description: String
  coverUrl: String
  creators: [Creator!]!
  platforms: [Platform!]!
  tags: [Tag!]!
  ratings: [Rating!]!
  averageRating: Float
  searchDepth: Int!
}

# Specific media type implementations
type Movie implements Media {
  id: UUID!
  title: String!
  releaseDate: Date
  description: String
  coverUrl: String
  creators: [Creator!]!
  platforms: [Platform!]!
  tags: [Tag!]!
  ratings: [Rating!]!
  averageRating: Float
  searchDepth: Int!
  # Movie-specific fields
  runtime: Int
  budget: Int
  boxOffice: Int
  cast: [Person!]!
  crew: [Person!]!
  # Structured credits with relationship properties
  castCredits: [PersonCredit!]!
  crewCredits: [CrewCredit!]!
  productionCompanies: [ProductionCompany!]!
  genres: [Genre!]!
  productionCountries: [ProductionCountry!]!
}

type ProductionCountry {
  id: UUID!
  name: String!
  movies: [Movie!]!
}

type TVShow implements Media {
  id: UUID!
  title: String!
  releaseDate: Date
  description: String
  coverUrl: String
  creators: [Creator!]!
  platforms: [Platform!]!
  tags: [Tag!]!
  ratings: [Rating!]!
  averageRating: Float
  searchDepth: Int!
  # TV-specific fields
  seasons: Int
  episodes: Int
  status: String # "Ongoing", "Ended", "Cancelled"
  # Public cast/crew and structured credits
  cast: [Person!]!
  crew: [Person!]!
  castCredits: [PersonCredit!]!
  crewCredits: [CrewCredit!]!
  productionCompanies: [ProductionCompany!]!
  genres: [Genre!]!
  productionCountries: [ProductionCountry!]!
}

type Book implements Media {
  id: UUID!
  title: String!
  releaseDate: Date
  description: String
  coverUrl: String
  creators: [Creator!]!
  authors: [Creator!]!
  platforms: [Platform!]!
  tags: [Tag!]!
  subjects: [Tag!]!
  publishers: [String!]!
  ratings: [Rating!]!
  averageRating: Float
  searchDepth: Int!
  # Book-specific fields
  pages: Int
  isbn: String
  publisher: String
}

type Game implements Media {
  id: UUID!
  title: String!
  releaseDate: Date
  description: String
  coverUrl: String
  creators: [Creator!]!
  platforms: [Platform!]!
  tags: [Tag!]!
  ratings: [Rating!]!
  averageRating: Float
  searchDepth: Int!
  # Game-specific fields
  genre: [String!]!
  esrbRating: String
  multiplayer: Boolean
}

type MusicAlbum implements Media {
  id: UUID!
  title: String!
  releaseDate: Date
  description: String
  coverUrl: String
  creators: [Creator!]!
  platforms: [Platform!]!
  tags: [Tag!]!
  ratings: [Rating!]!
  averageRating: Float
  searchDepth: Int!
  # Music-specific fields
  trackCount: Int
  duration: Int # in seconds
  label: String
}

type User {
  id: UUID!
  name: String!
  email: String!
  authProvider: String
  authSubject: String
  avatarUrl: String
  activities: [UserActivity!]!
  ratings: [Rating!]!
  favorites: [Media!]!
  recommendations: [Recommendation!]!
}

type Creator {
  id: UUID!
  name: String!
  role: CreatorRole!
  mediaItems: [Media!]!
}

type CreatorRole {
  id: Int!
  name: String!
}

type Platform {
  id: UUID!
  name: String!
  baseUrl: String
  mediaItems: [Media!]!
}

type UserActivity {
  id: UUID!
  user: User!
  media: Media!
  status: ActivityStatus!
  rating: Float
  review: String
  startedAt: DateTime
  finishedAt: DateTime
  sourcePlatform: Platform
}

type ActivityStatus {
  id: Int!
  name: String!
}

type Rating {
  user: User!
  media: Media!
  score: Float!
  ratedAt: DateTime!
}

type Recommendation {
  id: UUID!
  user: User!
  media: Media!
  recommender: User
  source: String
  score: Float
}

type Tag {
  id: UUID!
  name: String!
  type: String!
}

type Person {
  id: UUID!
  name: String!
  externalID: String
  actedIn: [Movie!]!
  crewOn: [Movie!]!
}

type ProductionCompany {
  id: UUID!
  name: String!
  produced: [Movie!]!
}

type Genre {
  id: UUID!
  name: String!
  movies: [Movie!]!
}

# Queries
type Query {
  user(id: UUID!): User
  users: [User!]!
  me: User!
  media(id: UUID!): Media
  allMedia: [Media!]!
  movies(limit: Int, offset: Int): [Movie!]!
  tvShows: [TVShow!]!
  books: [Book!]!
  games: [Game!]!
  musicAlbums: [MusicAlbum!]!
  }

# Structured credit types

type PersonCredit {
  person: Person!
  name: String!
  character: String
  order: Int
}

type CrewCredit {
  person: Person!
  name: String!
  job: String
  department: String
}

# Cast and crew result for any media
type CastAndCrewResult {
  cast: [Person!]!
  crew: [Person!]!
  castCredits: [PersonCredit!]!
  crewCredits: [CrewCredit!]!
}

extend type Query {
  castAndCrew(mediaID: UUID!): CastAndCrewResult!
}


# Mutations
type Mutation {
  createUser(input: CreateUserInput!): User!
  updateUser(id: UUID!, input: UpdateUserInput!): User!
  deleteUser(id: UUID!): Boolean!

  createMovie(input: CreateMovieInput!): Movie!
  createTVShow(input: CreateTVShowInput!): TVShow!
  createBook(input: CreateBookInput!): Book!
  createGame(input: CreateGameInput!): Game!
  createMusicAlbum(input: CreateMusicAlbumInput!): MusicAlbum!

  rateMedia(mediaId: UUID!, score: Float!): Rating!
  addToFavorites(mediaId: UUID!): Boolean!
  createActivity(input: CreateActivityInput!): UserActivity!
}

# Input types
input CreateUserInput {
  name: String!
  email: String!
  authProvider: String
  authSubject: String
  avatarUrl: String
}

input UpdateUserInput {
  name: String
  email: String
}

input CreateMovieInput {
  title: String!
  releaseDate: Date
  description: String
  coverUrl: String
  runtime: Int
  budget: Int
  boxOffice: Int
  cast: [String!]
  crew: [String!]
  productionCompanies: [String!]
  genres: [String!]
  searchDepth: Int
  maxConnections: Int
}

input CreateTVShowInput {
  title: String!
  releaseDate: Date
  description: String
  coverUrl: String
  seasons: Int
  episodes: Int
  status: String
  cast: [String!]
  crew: [String!]
  productionCompanies: [String!]
  genres: [String!]
  searchDepth: Int
  maxConnections: Int
}

input CreateBookInput {
  title: String!
  releaseDate: Date
  description: String
  coverUrl: String
  pages: Int
  isbn: String
  publisher: String
  authors: [String!]
  publishers: [String!]
  subjects: [String!]
  searchDepth: Int
}

input CreateGameInput {
  title: String!
  releaseDate: Date
  description: String
  coverUrl: String
  genre: [String!]!
  esrbRating: String
  multiplayer: Boolean
  searchDepth: Int
}

input CreateMusicAlbumInput {
  title: String!
  releaseDate: Date
  description: String
  coverUrl: String
  trackCount: Int
  duration: Int
  label: String
  searchDepth: Int
}

input CreateActivityInput {
  mediaId: UUID!
  statusId: Int!
  rating: Float
  review: String
  startedAt: DateTime
  finishedAt: DateTime
}
