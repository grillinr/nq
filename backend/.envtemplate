# RENAME THIS FILE TO .env AND FILL IN THE VALUES
# neo4j secrets
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=
AURA_INSTANCEID=
AURA_INSTANCENAME=
PORT=

# Environment (development, staging, production)
ENV=development

# Security settings
ENABLE_TLS=false
TLS_CERT_FILE=
TLS_KEY_FILE=
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19000

# Auth0 JWT validation
AUTH_JWT_ISSUER=
AUTH_JWT_AUDIENCE=
AUTH_JWT_JWKS_URL=

# Integration specific secrets
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
APPLE_MUSIC_API_KEY=

YOUTUBE_API_KEY=

TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

STEAM_API_KEY=

INSTAPAPER_USERNAME=
INSTAPAPER_PASSWORD=
